<% content_for :title, "面接を組む" %>

<main class="interviews-new">
  <h1>面接を組む</h1>

  <% if @interviewers.empty? %>
    <p class="hint">
      面接官（<code>interviewer</code>）が登録されていません。
      メンバー登録画面は後の段階で実装します。いまは <code>bin/rails db:seed</code> で投入できます。
    </p>
  <% else %>
    <%= form_with url: calendar_interviews_path, method: :get,
                  data: { turbo_frame: "week_calendar" }, class: "slot-form" do |form| %>
      <fieldset class="slot-form__interviewers">
        <legend>面接官（1名以上）</legend>
        <% @interviewers.each do |user| %>
          <label>
            <%= check_box_tag "user_ids[]", user.id, @user_ids.include?(user.id),
                  id: "user_ids_#{user.id}" %>
            <%= user.name %>
          </label>
        <% end %>
      </fieldset>

      <p>
        <%= label_tag :duration, "所要時間（分）" %>
        <%= select_tag :duration, options_for_select([ 15, 30, 45, 60, 90 ], @duration) %>
      </p>

      <%# 週送りはカレンダー側のリンクで行う。ここでは初期表示週のみ引き継ぐ %>
      <%= hidden_field_tag :week_of, @week_of.to_date.iso8601 %>

      <%= form.submit "カレンダーを表示" %>
    <% end %>

    <%= render "week_grid" %>
  <% end %>
</main>
