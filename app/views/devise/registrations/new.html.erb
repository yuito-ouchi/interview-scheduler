<% content_for :title, "会員登録" %>

<main class="session-new">
  <h1>会員登録</h1>

  <div class="card">
    <% if resource.errors.any? %>
      <ul class="errors">
        <% resource.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    <% end %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <p>
        <%= f.label :name, "氏名" %>
        <%= f.text_field :name, required: true %>
      </p>
      <p>
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, required: true, autocomplete: "email" %>
      </p>
      <p>
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password, required: true, autocomplete: "new-password" %>
      </p>

      <%# admin はここに置かない＝自己登録では絶対に付与しない境界
          （ApplicationController#configure_permitted_parameters が最終防波堤）。 %>
      <fieldset class="user-form__flags">
        <legend>役割（複数選択可）</legend>
        <label><%= f.check_box :operator, checked: true %> 主催者（ログインしてツールを操作できる）</label>
        <label><%= f.check_box :participant, checked: true %> 参加者（ミーティングの候補になる）</label>
      </fieldset>

      <%= f.submit "登録する" %>
    <% end %>

    <p class="session-new__links">
      <%= link_to "すでにアカウントをお持ちの方はこちら", new_session_path(resource_name) %>
    </p>
  </div>
</main>
