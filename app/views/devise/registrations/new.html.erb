<% content_for :title, "会員登録" %>

<main class="session-new">
  <h1>会員登録</h1>

  <div class="card">
    <% if resource.errors.any? %>
      <ul class="errors">
        <% resource.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    <% end %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <p>
        <%= f.label :name, "氏名" %>
        <%= f.text_field :name, required: true %>
      </p>
      <p>
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, required: true, autocomplete: "email" %>
      </p>
      <p>
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password, required: true, autocomplete: "new-password" %>
      </p>

      <%# 権限の選択肢は置かない。登録した人は全員メンバー（ログインでき、
          参加者候補にも並ぶ）で、admin は自己登録では絶対に付与しない
          （ApplicationController#configure_permitted_parameters が最終防波堤）。
          管理者にするのは既存adminのメンバー管理からのみ。判断メモ D-12・D-15。 %>
      <p class="hint">
        登録するとメンバーとして追加され、ミーティングの参加者候補に並びます。
      </p>

      <%= f.submit "登録する" %>
    <% end %>

    <p class="session-new__links">
      <%= link_to "すでにアカウントをお持ちの方はこちら", new_session_path(resource_name) %>
    </p>
  </div>
</main>
