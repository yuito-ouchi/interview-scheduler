<%# 週カレンダーと右サイドバー（参加者選択・所要時間）を1つの Turbo Frame にまとめて
    いる。サイドバーのフォームをこのフレームの外から data-turbo-frame で「離れた
    フレーム」として狙う実装だと、チェックボックスを連続で操作したときに一部の
    更新がブラウザ側で無視され、選択が反映されないことがあった（Turbo Frame への
    連続navigationに関する既知の癖）。フォームをフレームの内側に置き、素朴に
    「自分自身を更新する」形にすることで、この問題を避けている。 %>
<%= turbo_frame_tag "week_calendar" do %>
  <div class="meetings-layout">
    <div class="meetings-layout__main">
      <%= render "week_grid",
            week_path: ->(date) { calendar_meetings_path(week_of: date.iso8601, user_ids: @user_ids, duration: @duration) },
            slot_path: ->(start_at, end_at) {
              new_meeting_path(user_ids: @user_ids, duration: @duration, week_of: @week_of.to_date.iso8601,
                                start_at: start_at.iso8601, end_at: end_at.iso8601)
            },
            slot_turbo_frame: "booking_form" %>
      <%= render "booking_form" %>
    </div>

    <aside class="meetings-layout__sidebar">
      <%= form_with url: calendar_meetings_path, method: :get, id: "slot_form",
                    class: "search-panel card" do |form| %>
        <div class="search-panel__section">
          <h2>参加者（1名以上）</h2>
          <p class="search-panel__hint">チェックすると即座にカレンダーが更新されます</p>
          <div class="member-panel__list">
            <% @participants.each do |user| %>
              <label class="member-panel__item">
                <%= check_box_tag "user_ids[]", user.id, @user_ids.include?(user.id),
                      id: "user_ids_#{user.id}", onchange: "this.form.requestSubmit()" %>
                <%= user.name %>
              </label>
            <% end %>
          </div>
        </div>

        <div class="search-panel__section">
          <%= label_tag :duration, "所要時間（分）", for: "duration_search" %>
          <%= number_field_tag :duration, @duration, min: 5, step: 1,
                list: "duration_presets_search", id: "duration_search",
                class: "duration-input", onchange: "this.form.requestSubmit()" %>
          <datalist id="duration_presets_search">
            <option value="15"></option>
            <option value="30"></option>
            <option value="45"></option>
            <option value="60"></option>
            <option value="90"></option>
          </datalist>
        </div>

        <%# 週送りはカレンダー側のリンクで行う。ここでは初期表示週のみ引き継ぐ %>
        <%= hidden_field_tag :week_of, @week_of.to_date.iso8601 %>

        <%= form.submit "更新" %>
      <% end %>
    </aside>
  </div>
<% end %>
