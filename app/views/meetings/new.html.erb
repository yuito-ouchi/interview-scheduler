<% content_for :title, "ミーティングを組む" %>

<main class="meetings-new">
  <h1>ミーティングを組む</h1>

  <% if @participants.empty? %>
    <p class="hint">
      メンバーが登録されていません。
      設定の<%= link_to "メンバー管理", users_path %>から追加してください（管理者のみ）。
    </p>
  <% else %>
    <%= render "calendar_frame" %>
  <% end %>
</main>
